# wifi-connect :: your WiFi credentials.
#
# Copy this file to `.env` and fill in your network, then run `phpflash build`.
# The `.env` is baked into the firmware and read by PHP as $_ENV / getenv() -- it is NOT
# committed (see .gitignore); only this .env.example is. For an open network leave WIFI_PASSWORD empty.
WIFI_SSID=YourNetwork
WIFI_PASSWORD=YourPassword
