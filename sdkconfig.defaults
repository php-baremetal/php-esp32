# Base configuration -- board-agnostic knobs the PHP runtime needs on any board.
# Chip-level options live in boards/<family>/sdkconfig.family and board-level ones in
# boards/<family>/<board>/sdkconfig.board; the top CMakeLists layers all three via
# SDKCONFIG_DEFAULTS based on the selected board.

# The main task stack is bumped; the engine itself runs on its own task with a larger
# stack (see main/main.c).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768

# Custom partition layout (the app image is large). The actual .csv is chosen per
# board (CONFIG_PARTITION_TABLE_CUSTOM_FILENAME in sdkconfig.board).
CONFIG_PARTITION_TABLE_CUSTOM=y

# FAT long filenames. The default (8.3 short names only) can't open files like
# Composer's ShouldHandleEventsAfterCommit.php, so require/autoload from a real
# vendor/ tree fails. LFN_HEAP keeps the name buffer on the heap (PSRAM here).
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# A PHP script can legitimately run CPU-bound for tens of seconds (on-chip RSA-2048 key
# generation measured ~20-45 s here, and it's probabilistic so it varies), which starves the idle
# task and trips the task watchdog's default 5 s. Widen it generously so heavy compute doesn't
# spew watchdog dumps. It never panics (CONFIG_ESP_TASK_WDT_PANIC off), so this only affects the
# warning threshold, not a real hang guard.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60
