# ESP32-S3 family (chip-level) defaults. Layered on top of the base sdkconfig.defaults,
# and under the board's sdkconfig.board. Applies to every ESP32-S3 board.

CONFIG_IDF_TARGET="esp32s3"

# External SPI PSRAM -- this is where the runtime heap lives: with USE_ZEND_ALLOC=0 the
# engine uses malloc, and SPIRAM_USE_MALLOC routes allocations to PSRAM. Unlike the P4's
# in-package 32 MB, the S3 has an external PSRAM chip; the ESP32-S3-ETH carries 8 MB in
# OCTAL mode, which runs at 80 MHz.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Send ALL malloc() allocations to PSRAM (threshold 0), not just large ones. PHP makes
# thousands of small allocations; with the default 16 KB threshold they land in internal
# RAM and exhaust it, starving DMA and FreeRTOS. Internal-only needs (DMA, FreeRTOS
# objects) still get internal RAM via explicit caps.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
