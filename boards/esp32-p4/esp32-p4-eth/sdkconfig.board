# ESP32-P4-ETH board defaults. Layered last (over base + family), so board-specific
# choices win.

# Chip revision. Assumed the same early v1.x stepping as the P4-Pico (same vendor and
# era), which IDF 5.5.5 otherwise refuses to flash (it defaults to a v3.01 minimum).
# SELECTS_REV_LESS_V3 unlocks the <3.0 family, then REV_MIN_100 (v1.00) covers the chip.
# VERIFY on first flash: `esptool --port <port> chip_id` prints the real revision -- if
# it reports v3.x, drop these two lines instead.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# 32 MB NOR flash on board (the IDF default is 2 MB, which the app blows past).
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"

# Console on UART0. On this board the USB-C port is an onboard USB-UART bridge
# (CH343P) wired to UART0, so a single USB-C cable carries flashing and console.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# This board's partition layout (sized for the 32 MB flash). Path is relative to
# the project root.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="boards/esp32-p4/esp32-p4-eth/partitions.csv"
