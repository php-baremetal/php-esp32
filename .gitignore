# Build ESP-IDF
/build/
sdkconfig
sdkconfig.old
sdkconfig.ci

# Pristine PHP source: NOT versioned (210 MB, reproducible from the official
# tarball with a known sha256). Recreate it with: ./scripts/fetch-php.sh
/components/php/php-*/

# SQLite amalgamation for the optional PDO/SQLite extension: fetched on demand,
# not versioned. Recreate it with: ./scripts/fetch-sqlite.sh
/components/php/sqlite-amalgamation/

# Oniguruma regex library for the optional mbstring mb_ereg support: fetched on
# demand, not versioned. Recreate it with: ./scripts/fetch-oniguruma.sh
/components/php/oniguruma/

# Editor / OS
*.swp
.DS_Store

# editor local-history / nested repos
.history/
components/php/openssl-src/
components/php/openssl-build/

