Add a "PHP Baremetal Infos" section to phpinfo().

A second table right under phpinfo()'s general table, showing the project name, the
board, and the php-esp32 and ESP-IDF versions. The firmware sets these as C globals
(php_esp32_project / _board / _version / _idf_version, in main.c) and also exposes them in
$_SERVER; info.c reads the globals directly (so they stay out of $_ENV / the environment).

--- a/ext/standard/info.c
+++ b/ext/standard/info.c
@@ -907,6 +907,18 @@
 
 		php_info_print_table_end();
 
+		/* PHP Baremetal Infos -- project/board/version, from the php-esp32 firmware (main.c). */
+		{
+			extern const char *php_esp32_project, *php_esp32_board, *php_esp32_version, *php_esp32_idf_version;
+			php_info_print_table_start();
+			php_info_print_table_colspan_header(2, "PHP Baremetal Infos");
+			php_info_print_table_row(2, "Project", php_esp32_project);
+			php_info_print_table_row(2, "Board", php_esp32_board);
+			php_info_print_table_row(2, "php-esp32 version", php_esp32_version);
+			php_info_print_table_row(2, "ESP-IDF version", php_esp32_idf_version);
+			php_info_print_table_end();
+		}
+
 		/* Zend Engine */
 		php_info_print_box_start(0);
 		if (!sapi_module.phpinfo_as_text) {
